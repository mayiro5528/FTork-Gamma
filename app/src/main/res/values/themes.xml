<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- FTalk Beta 화면이 기본 다크라서 앱 바탕도 같은 색으로 맞춰요. -->
    <style name="Theme.FTorkGamma" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ftalk_bg</item>
        <item name="android:statusBarColor">@color/ftalk_bg</item>
        <item name="android:navigationBarColor">@color/ftalk_bg</item>
    </style>

    <!-- 실시간 카메라 화면: 검은 바탕 -->
    <style name="Theme.FTorkGamma.Camera" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
